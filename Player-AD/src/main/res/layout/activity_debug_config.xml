<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- Barra fixa: não roda com o preview — orientação e gravar sempre visíveis -->
    <LinearLayout
        android:id="@+id/configActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#121212"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/textPlayerVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Player-AD"
            android:textColor="#90CAF9"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/panelOrientation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A237E"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Orientação do painel"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="Rode 90° no sentido horário ou anti-horário. A área abaixo mostra o preview. Ações ficam nesta barra."
                android:textColor="#C5CAE9"
                android:textSize="12sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRotateCcw"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="⟲ 90° anti-horário"/>

                <TextView
                    android:id="@+id/textOrientationDegrees"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1.2"
                    android:gravity="center"
                    android:text="0° retrato"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnRotateCw"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="90° horário ⟳"/>
            </LinearLayout>

            <!-- Mantido oculto para compatibilidade de IDs / leitura legada -->
            <Spinner
                android:id="@+id/spinnerScreenOrientation"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnApplyAndStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Aplicar e iniciar"/>

            <Button
                android:id="@+id/btnStartWithoutSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Iniciar sem salvar"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTestHeartbeat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Testar conectividade"/>

            <Button
                android:id="@+id/btnTestDispatch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Playlist"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnRegisterActivation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Vincular código ao hardware"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/textStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status..."
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textIsSelectable="true"/>
        </ScrollView>
    </LinearLayout>

    <br.com.smartchannel.playerad.ui.ConfigContentHost
        android:id="@+id/configContentHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ScrollView
            android:id="@+id/configScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:fillViewport="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

        <TextView
            android:id="@+id/textReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:text="Configuração do Player"/>

        <LinearLayout
            android:id="@+id/panelSuSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E2A1E"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/su_section_title"
                android:textColor="#A5D6A7"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/su_section_hint"
                android:textColor="#C8E6C9"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textSuStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/su_status_pending"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRequestSu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/su_btn_request" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Na configuração inicial, «Aplicar e iniciar» (barra fixa no topo) fica ativo com serverUrl, uin e deviceId preenchidos."
            android:textColor="#BDBDBD"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#FFFFFF"
            android:text="serverUrl"/>

        <EditText
            android:id="@+id/editServerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:hint="https://totemdigital.app.br"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FFFFFF"
            android:text="uin"/>

        <EditText
            android:id="@+id/editUin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:hint="DEMO-UIN-001"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FFFFFF"
            android:text="deviceId"/>

        <EditText
            android:id="@+id/editDeviceId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:hint="DEMO-UIN-001"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:text="Aceitar imagens na playlist"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:text="Desligado: itens de imagem são ignorados (só vídeo)."/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAcceptImages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:checked="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:text="Áudio na reprodução (vídeo)"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:text="Desligado: mute permanente no totem (ExoPlayer volume 0). Ligado: som conforme a mídia."/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAllowPlaybackAudio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:checked="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:text="Transição escura entre mídias"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:text="Ligado (1): véu preto ~60 ms na troca (reduz flick). Desligado (0): troca directa sem escurecer. Campo JSON: mediaTransitionEnabled."/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchMediaTransition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:checked="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:text="Kiosk forte (bloqueio HOME/recents)"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:text="Ligado: lock task + teclas de sistema bloqueadas. Desligado: só fullscreen imersivo. Nesta tela de debug o kiosk fica sempre relaxado."/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchStrongKiosk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:checked="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FFFFFF"
            android:text="Provisionamento do sistema (ADB)"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:text="Somente leitura. Portrait no SO e launcher exigem install-player-adb.ps1 no PC com depuração USB."/>

        <TextView
            android:id="@+id/textSystemProvisioning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#9E9E9E"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:text="A carregar..."/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:text="Batimento cardiaco (segundos)"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:text="Intervalo do heartbeat: comandos remotos, OTA, presença online. Sem pedir dispatch. Mínimo: 10s (recomendado: 120s)."/>

        <EditText
            android:id="@+id/editBatimentoCardiaco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:hint="120"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:text="Atualizar plano / dispatch (segundos)"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:text="Intervalo para GET /dispatch (plano de mídia). Independente do fim de ciclo. Mínimo: 10s (recomendado: 600s)."/>

        <EditText
            android:id="@+id/editMaxSecondsWithoutServerCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:hint="60"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:text="Sonolência do batimento (pollAdaptive)"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:text="Aumenta o intervalo quando o servidor responde sem mudanças; fora do horário de tela usa base idle. Pode ser sobrescrito pelo cadastro do totem."/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchPollSleepEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#FFFFFF"
                android:text="Ativar sonolência"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:text="Sucessos iguais antes de dormir"/>

        <EditText
            android:id="@+id/editPollUnchangedBeforeSleep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:hint="2"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:text="Heartbeat em idle / teto (segundos)"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editPollIdleHeartbeat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:hint="120"/>

            <EditText
                android:id="@+id/editPollMaxHeartbeat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:hint="600"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:text="Dispatch em idle / teto (segundos)"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editPollIdleDispatch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:hint="600"/>

            <EditText
                android:id="@+id/editPollMaxDispatch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:hint="1800"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelDisplaySchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#1A237E"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Horário de tela (ligar / desligar)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="Vem do cadastro do totem (servidor). O técnico pode ajustar aqui; no próximo heartbeat o servidor sobrescreve estes valores. Fora do horário a saída fica preta sem encerrar o player."
                android:textColor="#C5CAE9"
                android:textSize="12sp"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchDisplayScheduleEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Ativar horário de tela"
                android:textColor="#FFFFFF"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Ligar (HH:mm)"
                android:textColor="#FFFFFF"/>

            <EditText
                android:id="@+id/editDisplayOnTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="08:00"
                android:inputType="time"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Desligar (HH:mm)"
                android:textColor="#FFFFFF"/>

            <EditText
                android:id="@+id/editDisplayOffTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="22:00"
                android:inputType="time"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Fuso (ex.: America/Sao_Paulo)"
                android:textColor="#FFFFFF"/>

            <EditText
                android:id="@+id/editDisplayTimezone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="America/Sao_Paulo"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Dias (0=dom … 6=sáb, separados por vírgula)"
                android:textColor="#FFFFFF"/>

            <EditText
                android:id="@+id/editDisplayDaysOfWeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0,1,2,3,4,5,6"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchDisplayKeepAlive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Keep-alive anti-standby fora do horário"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/textDisplayScheduleStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:textColor="#90CAF9"
                android:textSize="12sp"
                android:text=""/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Hora atual do sistema (Player-AD)"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/textDeviceSystemTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:textColor="#FFD54F"
                android:textSize="14sp"
                android:text="—"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:text="Armazenamento (mídias / cache)"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:text="auto = preferir USB/SD se exposto; default de campo/kit = external_primary (eMMC da app). path_override = pasta absoluta."/>

        <Spinner
            android:id="@+id/spinnerStorage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:text="Caminho (só se path_override)"/>

        <EditText
            android:id="@+id/editStoragePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:hint="/storage/.../Android/data/.../files"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:text="Teto cache (MB) — maxCacheSizeMb (50–8192)"/>

        <EditText
            android:id="@+id/editMaxCacheSizeMb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:hint="1000"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:text="% do volume (opcional) — maxCachePercentOfVolume (1–90, vazio = só MB)"/>

        <EditText
            android:id="@+id/editMaxCachePercentOfVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:hint="ex. 40"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:text="Rede local (IPv4)"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:text="Interfaces detectadas neste aparelho (eth/en = cabo, wlan = Wi‑Fi)."/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOpenSystemWifi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Abrir Wi‑Fi do sistema"/>

            <Button
                android:id="@+id/btnOpenSystemSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Abrir Settings"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:text="Escape do kiosk (técnico)"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:text="Nesta tela o Player-AD deixa de ser HOME. Explorador e menu Android (launcher da box). «Aplicar e iniciar» volta ao totem."/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOpenFileExplorer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Explorador de ficheiros"/>

            <Button
                android:id="@+id/btnOpenSystemLauncher"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Menu principal"/>
        </LinearLayout>

        <TextView
            android:id="@+id/textKioskEscapeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#81C784"
            android:textSize="12sp"
            android:text=""/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:text="Wi‑Fi (configurar neste aparelho)"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:text="Liste redes, escolha SSID e introduza a senha. Em kiosk forte use estes botões ou 3× OK no player para voltar aqui."/>

        <TextView
            android:id="@+id/textWifiCurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#81C784"
            android:textSize="13sp"
            android:text="SSID actual: —"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnWifiScan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Procurar redes"/>

            <Button
                android:id="@+id/btnWifiConnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Ligar"/>
        </LinearLayout>

        <Spinner
            android:id="@+id/spinnerWifiNetworks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <EditText
            android:id="@+id/editWifiPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Senha Wi‑Fi (deixe vazio se rede aberta)"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"/>

        <TextView
            android:id="@+id/textWifiStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:text=""/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#9CCC65"
            android:textSize="12sp"
            android:text="Ethernet"/>

        <TextView
            android:id="@+id/textIpEthernet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:text="—"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#64B5F6"
            android:textSize="12sp"
            android:text="Wi‑Fi"/>

        <TextView
            android:id="@+id/textIpWifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:text="—"/>

        <TextView
            android:id="@+id/labelIpOther"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:visibility="gone"
            android:text="Outras interfaces"/>

        <TextView
            android:id="@+id/textIpOther"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:visibility="gone"
            android:text=""/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:text="Estado offline"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#BDBDBD"
            android:textSize="11sp"
            android:text="Fonte do plano, último DispatchPlan persistido e total de mídias locais (propagandas/vinhetas)."/>

        <TextView
            android:id="@+id/textOfflineState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#E0E0E0"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:text="(carregar...)"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Registo operacional"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#BDBDBD"
            android:textSize="11sp"
            android:text="Ações, erros e recebimento de DispatchPlan (data/hora). Ficheiro privado em filesDir do app."/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnRefreshOperationalLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Atualizar registo"/>

            <Button
                android:id="@+id/btnClearOperationalLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Limpar registo"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="8dp"
            android:fillViewport="true"
            android:background="#1A1A1A">

            <TextView
                android:id="@+id/textOperationalLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:textColor="#E0E0E0"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:text="(carregar…)"/>
        </ScrollView>

            </LinearLayout>
        </ScrollView>
    </br.com.smartchannel.playerad.ui.ConfigContentHost>
</LinearLayout>

