<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:text="Modo desenvolvimento"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#BDBDBD"
            android:text="Preencha e teste antes de aplicar. O botão 'Aplicar e iniciar' só libera após heartbeat OK."/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#FFFFFF"
            android:text="serverUrl"/>

        <EditText
            android:id="@+id/editServerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:hint="http://192.168.1.110"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FFFFFF"
            android:text="uin"/>

        <EditText
            android:id="@+id/editUin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:hint="tot001"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FFFFFF"
            android:text="deviceId"/>

        <EditText
            android:id="@+id/editDeviceId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:hint="android-tv-tot001"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:text="Aceitar imagens na playlist"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:text="Desligado: itens de imagem são ignorados (só vídeo)."/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAcceptImages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:checked="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:text="Áudio na reprodução (vídeo)"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:text="Desligado: mute permanente no totem (ExoPlayer volume 0). Ligado: som conforme a mídia."/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAllowPlaybackAudio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:checked="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:text="Máx. segundos sem verificar servidor"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:text="Checagem híbrida: por ciclo + tempo máximo. Mínimo: 10s (recomendado: 30-60s)."/>

        <EditText
            android:id="@+id/editMaxSecondsWithoutServerCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:hint="60"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:text="Armazenamento (mídias / cache)"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:text="auto = preferir volume removível (USB/SD) se o Android expuser em getExternalFilesDirs; path_override = pasta absoluta."/>

        <Spinner
            android:id="@+id/spinnerStorage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:text="Caminho (só se path_override)"/>

        <EditText
            android:id="@+id/editStoragePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:hint="/storage/.../Android/data/.../files"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:text="Rede local (IPv4)"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:text="Interfaces detectadas neste aparelho (eth/en = cabo, wlan = Wi‑Fi)."/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#9CCC65"
            android:textSize="12sp"
            android:text="Ethernet"/>

        <TextView
            android:id="@+id/textIpEthernet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:text="—"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#64B5F6"
            android:textSize="12sp"
            android:text="Wi‑Fi"/>

        <TextView
            android:id="@+id/textIpWifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:text="—"/>

        <TextView
            android:id="@+id/labelIpOther"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:visibility="gone"
            android:text="Outras interfaces"/>

        <TextView
            android:id="@+id/textIpOther"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:visibility="gone"
            android:text=""/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:text="Estado offline"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#BDBDBD"
            android:textSize="11sp"
            android:text="Fonte do plano, último DispatchPlan persistido e total de mídias locais (propagandas/vinhetas)."/>

        <TextView
            android:id="@+id/textOfflineState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#E0E0E0"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:text="(carregar...)"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <Button
                android:id="@+id/btnRegisterActivation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vincular código ao hardware"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnTestHeartbeat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Teste heartbeat"/>

            <Button
                android:id="@+id/btnTestDispatch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="DispatchPlan"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnApplyAndStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Aplicar e iniciar"/>

            <Button
                android:id="@+id/btnStartWithoutSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Iniciar sem salvar"/>
        </LinearLayout>

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:text="Status..."/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:text="Registo operacional"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#BDBDBD"
            android:textSize="11sp"
            android:text="Ações, erros e recebimento de DispatchPlan (data/hora). Ficheiro privado em filesDir do app."/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnRefreshOperationalLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Atualizar registo"/>

            <Button
                android:id="@+id/btnClearOperationalLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Limpar registo"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="8dp"
            android:fillViewport="true"
            android:background="#1A1A1A">

            <TextView
                android:id="@+id/textOperationalLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:textColor="#E0E0E0"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:text="(carregar…)"/>
        </ScrollView>

    </LinearLayout>
</ScrollView>

