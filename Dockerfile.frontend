# Smart Signage Pro v2.0 - Dockerfile Frontend Completo
# Container que serve frontend estático + proxy para backend

FROM node:18-alpine AS builder

# Instalar dependências do sistema
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    curl \
    bash

# Definir diretório de trabalho
WORKDIR /app/frontend

# Copiar APENAS o package.json do frontend (explicito)
COPY frontend/package.json ./package.json

# Instalar dependências do frontend (incluindo dev para build)
RUN npm install --include=dev

# Copiar código fonte do frontend
COPY frontend/public ./public
COPY frontend/src ./src

# Build do Frontend
RUN npm run build

# Estágio de produção com Nginx Completo
FROM nginx:alpine AS production

# Instalar dependências do sistema
RUN apk add --no-cache \
    curl \
    bash \
    tzdata

# Definir timezone
ENV TZ=America/Sao_Paulo

# =============================================================================
# ORDEM CRÍTICA: Remover arquivos padrão PRIMEIRO antes de copiar arquivos customizados
# =============================================================================

# ETAPA 1: Remover TODOS os arquivos padrão do Nginx ANTES de copiar nossos arquivos
# Isso garante que a página padrão "Welcome to nginx!" seja completamente removida
# ORDEM CRÍTICA: Fazer isso PRIMEIRO, antes de qualquer COPY
RUN rm -rf /etc/nginx/conf.d/*.conf \
    && rm -rf /usr/share/nginx/html/* \
    && rm -rf /usr/share/nginx/html/.* 2>/dev/null || true \
    && ls -la /usr/share/nginx/html/ || echo "Diretório vazio (correto)" \
    && echo "✅ Arquivos padrão do Nginx removidos COMPLETAMENTE"

# ETAPA 2: Criar diretório limpo para nosso frontend
RUN mkdir -p /usr/share/nginx/html/assets \
    && chown -R nginx:nginx /usr/share/nginx/html \
    && chmod -R 755 /usr/share/nginx/html

# ETAPA 3: Copiar build do frontend (AGORA o diretório está limpo)
COPY --from=builder /app/frontend/build /usr/share/nginx/html

# ETAPA 4: Copiar configuração completa do Nginx (frontend + proxy)
COPY nginx/nginx-complete.conf /etc/nginx/nginx.conf

# ETAPA 5: Garantir que NÃO há arquivos padrão remanescentes
RUN rm -f /usr/share/nginx/html/50x.html \
    && rm -f /usr/share/nginx/html/index.html.orig \
    && find /usr/share/nginx/html -name "index.*.html" ! -name "index.html" -delete 2>/dev/null || true \
    && echo "✅ Limpeza final concluída"

# Copiar entrypoint customizado
COPY docker/nginx-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Criar diretórios necessários e garantir permissões corretas
# IMPORTANTE: Nginx roda workers como usuário 'nginx' (não-privilegiado)
# O processo master inicia como root (necessário para porta 80), mas workers são nginx
RUN mkdir -p /usr/share/nginx/html/assets && \
    chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    chmod -R 755 /usr/share/nginx/html && \
    chmod -R 755 /var/cache/nginx && \
    chmod -R 755 /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid

# ETAPA 7: Verificar que index.html existe e é nosso frontend (não página padrão)
RUN echo "🔍 Verificando index.html..." \
    && ls -la /usr/share/nginx/html/index.html || (echo "❌ ERRO: index.html não encontrado!" && exit 1) \
    && echo "   Arquivo existe: $(stat -c%s /usr/share/nginx/html/index.html 2>/dev/null || echo 'N/A') bytes" \
    && echo "   Primeira linha: $(head -1 /usr/share/nginx/html/index.html | cut -c1-60)..." \
    && if grep -qiE "(Welcome to nginx|nginx web server|nginx.org|nginx.com)" /usr/share/nginx/html/index.html 2>/dev/null; then \
        echo "❌ ERRO CRÍTICO: index.html ainda é a página padrão do Nginx!"; \
        echo "   Isso não deveria acontecer - arquivos padrão foram removidos primeiro"; \
        exit 1; \
    fi \
    && if ! grep -qiE "(<!doctype|<html|<div.*root|react)" /usr/share/nginx/html/index.html 2>/dev/null | head -1; then \
        echo "⚠️  AVISO: index.html não parece ser um arquivo React válido"; \
        echo "   Verificando conteúdo..."; \
        head -5 /usr/share/nginx/html/index.html; \
    fi \
    && echo "✅ index.html correto - é nosso frontend React"

# Expor porta
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:80 || exit 1

# Comando de inicialização (usa entrypoint customizado)
ENTRYPOINT ["/docker-entrypoint.sh"]
