<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101018"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="36dp">

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Instala Player TotemDigital"
        android:textColor="#FFFFC107"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:textColor="#FFE8E8E8"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="#FFB0B0B0"
        android:textSize="15sp" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#FFFFC107"
            android:minHeight="56dp"
            android:textColor="#FF101018"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#FF2A2A38"
            android:minHeight="56dp"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnTertiary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#FF2A2A38"
            android:minHeight="56dp"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
