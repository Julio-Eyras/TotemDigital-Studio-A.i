{
  "database": {
    "provider": "PostgreSQL",
    "host": "localhost",
    "port": 5432,
    "database": "smartsignage",
    "username": "smartsignage",
    "password": "smartsignage123",
    "connectionTimeout": 30,
    "sslMode": "Prefer",
    "poolSize": 10
  },
  "export": {
    "outputDirectory": "./exports",
    "fileFormat": "xlsx",
    "timestampSuffix": true,
    "dateFormat": "yyyyMMdd_HHmmss",
    "createSubfolders": true,
    "applyFormatting": true,
    "cleanupOldFiles": false,
    "keepFilesDays": 30
  },
  "queries": [
    {
      "name": "totems_ativos",
      "description": "Lista todos os totens ativos",
      "sql": "SELECT * FROM totems WHERE active = true ORDER BY created_at DESC",
      "sheetName": "Totens Ativos",
      "fileName": "totems_ativos",
      "timeout": 60,
      "enabled": true,
      "parameters": {}
    },
    {
      "name": "clientes_ativos",
      "description": "Lista todos os clientes ativos",
      "sql": "SELECT * FROM clients WHERE active = true ORDER BY name",
      "sheetName": "Clientes Ativos",
      "fileName": "clientes_ativos",
      "timeout": 60,
      "enabled": true,
      "parameters": {}
    }
  ],
  "logging": {
    "level": "Info",
    "logToFile": true,
    "logDirectory": "./logs",
    "maxLogFiles": 10,
    "logRotation": true
  }
}

