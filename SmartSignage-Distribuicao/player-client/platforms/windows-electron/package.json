{
  "name": "smartsignage-player-windows",
  "version": "1.0.0",
  "description": "Smart Signage Player for Windows (Electron)",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "install": "npm install",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "electron",
    "windows",
    "digital-signage"
  ],
  "author": "Smart Signage Solutions",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "mqtt": "^5.0.0"
  },
  "build": {
    "appId": "com.smartsignage.player",
    "productName": "Smart Signage Player",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "renderer/assets/icon.ico"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ]
  }
}

