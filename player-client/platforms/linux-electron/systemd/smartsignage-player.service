[Unit]
Description=Smart Signage Player
After=network.target

[Service]
Type=simple
User=smartsignage
WorkingDirectory=/opt/smartsignage-player
ExecStart=/usr/bin/electron /opt/smartsignage-player
Restart=always
RestartSec=10
Environment="NODE_ENV=production"
Environment="API_BASE_URL=http://localhost:3000"
Environment="TOTEM_UIN="
Environment="TOTEM_SECRET="

[Install]
WantedBy=multi-user.target

