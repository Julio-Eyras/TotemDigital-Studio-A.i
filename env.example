# Smart Signage Pro v2.0 - Configuração de Ambiente
# Copie este arquivo para .env e configure as variáveis

# =============================================
# SERVIDOR
# =============================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# =============================================
# PORTAS DOS SERVIÇOS (Docker)
# =============================================
# IMPORTANTE: As portas INTERNAS são onde os serviços escutam DENTRO do container
#            As portas EXTERNAS são onde o host expõe os serviços (mapeamento host:container)
#
# Exemplo: FRONTEND_INTERNAL_PORT=8080 (nginx escuta dentro do container)
#          FRONTEND_PORT=9090 (host expõe 9090, que mapeia para 8080 do container)
#          Acesso: http://host:9090 -> container:8080

# Portas INTERNAS (dentro dos containers - onde os serviços escutam)
FRONTEND_INTERNAL_PORT=8080    # Porta que o Nginx escuta dentro do container
BACKEND_INTERNAL_PORT=3000     # Porta que o Node.js escuta dentro do container
POSTGRES_INTERNAL_PORT=5432    # Porta que o PostgreSQL escuta dentro do container
REDIS_INTERNAL_PORT=6379       # Porta que o Redis escuta dentro do container
PROMETHEUS_INTERNAL_PORT=9090  # Porta que o Prometheus escuta dentro do container
GRAFANA_INTERNAL_PORT=3000     # Porta que o Grafana escuta dentro do container
OLLAMA_INTERNAL_PORT=11434      # Porta que o Ollama escuta dentro do container

# Portas EXTERNAS (no host - mapeamento host:container)
# Por padrão, todas as portas externas são iguais às internas (mesma porta no host e container)
FRONTEND_PORT=8080             # Host:8080 -> Container:8080 (mesma porta)
FRONTEND_ALT_PORT=3001        # Host:3001 -> Container:8080 (porta alternativa do frontend)
BACKEND_PORT=3000              # Host:3000 -> Container:3000 (mesma porta)
POSTGRES_PORT=5432             # Host:5432 -> Container:5432 (mesma porta)
REDIS_PORT=6379                # Host:6379 -> Container:6379 (mesma porta)
PROMETHEUS_PORT=9090           # Host:9090 -> Container:9090 (mesma porta)
GRAFANA_PORT=3000              # Host:3000 -> Container:3000 (mesma porta)
OLLAMA_PORT=11434              # Host:11434 -> Container:11434 (mesma porta)

# Exemplo de uso com portas diferentes:
# Se a porta 8080 já estiver ocupada no host, você pode fazer:
# FRONTEND_INTERNAL_PORT=8080  # Nginx continua escutando 8080 dentro do container
# FRONTEND_PORT=9090           # Host expõe 9090, que mapeia para 8080 do container
# Acesso: http://host:9090 -> container:8080

# =============================================
# BANCO DE DADOS
# =============================================
# Escolha um tipo de banco (sqlite ou postgresql)
DATABASE_TYPE=sqlite
DATABASE_URL=file:./data/smartsignage.db

# Para PostgreSQL (descomente e configure se necessário)
# DATABASE_TYPE=postgresql
# DATABASE_URL=postgresql://username:password@localhost:5432/smartsignage

# =============================================
# AUTENTICAÇÃO
# =============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# =============================================
# ARMAZENAMENTO
# =============================================
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=100MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,video/ogg,audio/mp3,audio/wav,audio/ogg

# =============================================
# REDIS (OPCIONAL)
# =============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================
# EMAIL
# =============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Smart Signage <noreply@smartsignage.com>

# =============================================
# LOGS
# =============================================
LOG_LEVEL=info
LOG_FILE=./logs/smartsignage.log
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=5

# =============================================
# SEGURANÇA
# =============================================
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:3000,http://localhost:80

# =============================================
# PLAYER
# =============================================
PLAYER_API_URL=http://localhost:3000/api
PLAYER_HEARTBEAT_INTERVAL=30000
PLAYER_PLAYLIST_UPDATE_INTERVAL=300000
PLAYER_DEFAULT_DURATION=10000

# =============================================
# ANALYTICS
# =============================================
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=365
ANALYTICS_BATCH_SIZE=1000

# =============================================
# BACKUP
# =============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups

# =============================================
# MONITORAMENTO
# =============================================
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true
METRICS_PORT=9090

# =============================================
# DESENVOLVIMENTO
# =============================================
DEBUG=false
VERBOSE_LOGGING=false
HOT_RELOAD=true
