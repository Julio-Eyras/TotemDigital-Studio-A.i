# Build de produção (npm run build): TotemDigital em modo compacto por defeito.
# Alinha com a raiz .env / instalador (REACT_APP_TOTEMDIGITAL_COMPACT).
REACT_APP_TOTEMDIGITAL_COMPACT=true
# Opcional: espelhar DISABLE_DIRECT_CAMPAIGN_TOTEM do backend (fallback se ui-context indisponível).
# REACT_APP_DISABLE_DIRECT_CAMPAIGN_TOTEM=true
