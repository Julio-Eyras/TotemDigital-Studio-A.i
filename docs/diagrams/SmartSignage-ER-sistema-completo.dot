digraph SmartSignageERClusters {
  graph [rankdir=TB; bgcolor=white; fontsize=12; dpi=150;
        label="SmartSignage Pro — modelo de dados completo (por ficheiro schema v2)\nCada caixa lista todas as tabelas definidas nesse part*.sql";
        labelloc=t; labeljust=l; nodesep=0.35; ranksep=0.6;]
  node [fontname="Helvetica"];
  edge [color="#333333"];

  n_0 [shape=plaintext label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='3'><TR><TD BGCOLOR='#d6e3f7' COLSPAN='1'><B>part1-schema-setup</B><BR/><FONT POINT-SIZE='9'>(1 tabelas)</FONT></TD></TR><TR><TD ALIGN='LEFT'>schema_version</TD></TR></TABLE>>];
  n_1 [shape=plaintext label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='3'><TR><TD BGCOLOR='#d6e3f7' COLSPAN='1'><B>part11-playlist-mix</B><BR/><FONT POINT-SIZE='9'>(4 tabelas)</FONT></TD></TR><TR><TD ALIGN='LEFT'>ai_context_data</TD></TR><TR><TD ALIGN='LEFT'>playlist_mix_history</TD></TR><TR><TD ALIGN='LEFT'>playlist_mix_rules</TD></TR><TR><TD ALIGN='LEFT'>totem_playlist_mix</TD></TR></TABLE>>];
  n_2 [shape=plaintext label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='3'><TR><TD BGCOLOR='#d6e3f7' COLSPAN='1'><B>part14-reconcile</B><BR/><FONT POINT-SIZE='9'>(1 tabelas)</FONT></TD></TR><TR><TD ALIGN='LEFT'>reconcile_plan_publisher_jobs</TD></TR></TABLE>>];
  n_3 [shape=plaintext label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='3'><TR><TD BGCOLOR='#d6e3f7' COLSPAN='1'><B>part15-contracts</B><BR/><FONT POINT-SIZE='9'>(1 tabelas)</FONT></TD></TR><TR><TD ALIGN='LEFT'>contract_change_audit</TD></TR></TABLE>>];
  n_4 [shape=plaintext label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='3'><TR><TD BGCOLOR='#d6e3f7' COLSPAN='1'><B>part2-tables-base</B><BR/><FONT POINT-SIZE='9'>(18 tabelas)</FONT></TD></TR><TR><TD ALIGN='LEFT'>ai_models</TD></TR><TR><TD ALIGN='LEFT'>alert_rules</TD></TR><TR><TD ALIGN='LEFT'>fx_effects</TD></TR><TR><TD ALIGN='LEFT'>fx_rules</TD></TR><TR><TD ALIGN='LEFT'>fx_timelines</TD></TR><TR><TD ALIGN='LEFT'>ml_models</TD></TR><TR><TD ALIGN='LEFT'>permissions</TD></TR><TR><TD ALIGN='LEFT'>plans</TD></TR><TR><TD ALIGN='LEFT'>publishers</TD></TR><TR><TD ALIGN='LEFT'>role_flags_default</TD></TR><TR><TD ALIGN='LEFT'>roles</TD></TR><TR><TD ALIGN='LEFT'>subscribers</TD></TR><TR><TD ALIGN='LEFT'>system_logs</TD></TR><TR><TD ALIGN='LEFT'>system_settings</TD></TR><TR><TD ALIGN='LEFT'>user_flags</TD></TR><TR><TD ALIGN='LEFT'>users</TD></TR><TR><TD ALIGN='LEFT'>webhook_configs</TD></TR><TR><TD ALIGN='LEFT'>webhooks</TD></TR></TABLE>>];
  n_5 [shape=plaintext label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='3'><TR><TD BGCOLOR='#d6e3f7' COLSPAN='1'><B>part3-tables-dependent</B><BR/><FONT POINT-SIZE='9'>(7 tabelas)</FONT></TD></TR><TR><TD ALIGN='LEFT'>campaigns</TD></TR><TR><TD ALIGN='LEFT'>locals</TD></TR><TR><TD ALIGN='LEFT'>medias</TD></TR><TR><TD ALIGN='LEFT'>playlist_items</TD></TR><TR><TD ALIGN='LEFT'>playlists</TD></TR><TR><TD ALIGN='LEFT'>smart_tvs</TD></TR><TR><TD ALIGN='LEFT'>totems</TD></TR></TABLE>>];
  n_6 [shape=plaintext label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='3'><TR><TD BGCOLOR='#d6e3f7' COLSPAN='1'><B>part4-billing-contracts</B><BR/><FONT POINT-SIZE='9'>(4 tabelas)</FONT></TD></TR><TR><TD ALIGN='LEFT'>publisher_billing</TD></TR><TR><TD ALIGN='LEFT'>publisher_contracts</TD></TR><TR><TD ALIGN='LEFT'>subscriber_billing</TD></TR><TR><TD ALIGN='LEFT'>subscriber_contracts</TD></TR></TABLE>>];
  n_7 [shape=plaintext label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='3'><TR><TD BGCOLOR='#d6e3f7' COLSPAN='1'><B>part5-tables-relationships</B><BR/><FONT POINT-SIZE='9'>(13 tabelas)</FONT></TD></TR><TR><TD ALIGN='LEFT'>campaign_locals</TD></TR><TR><TD ALIGN='LEFT'>campaign_medias</TD></TR><TR><TD ALIGN='LEFT'>campaign_playlists</TD></TR><TR><TD ALIGN='LEFT'>campaign_publishers</TD></TR><TR><TD ALIGN='LEFT'>campaign_totems</TD></TR><TR><TD ALIGN='LEFT'>plan_publisher_access</TD></TR><TR><TD ALIGN='LEFT'>role_permissions</TD></TR><TR><TD ALIGN='LEFT'>subscriber_publisher_access</TD></TR><TR><TD ALIGN='LEFT'>subscriptions</TD></TR><TR><TD ALIGN='LEFT'>totem_playlist_generation_log</TD></TR><TR><TD ALIGN='LEFT'>totem_playlist_items</TD></TR><TR><TD ALIGN='LEFT'>totem_playlists</TD></TR><TR><TD ALIGN='LEFT'>user_roles</TD></TR></TABLE>>];
  n_8 [shape=plaintext label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='3'><TR><TD BGCOLOR='#d6e3f7' COLSPAN='1'><B>part6-tables-other</B><BR/><FONT POINT-SIZE='9'>(40 tabelas)</FONT></TD></TR><TR><TD ALIGN='LEFT'>advanced_schedules</TD></TR><TR><TD ALIGN='LEFT'>analytics_emotions</TD></TR><TR><TD ALIGN='LEFT'>analytics_gestures</TD></TR><TR><TD ALIGN='LEFT'>analytics_sessions</TD></TR><TR><TD ALIGN='LEFT'>audit_logs</TD></TR><TR><TD ALIGN='LEFT'>backups</TD></TR><TR><TD ALIGN='LEFT'>behavior_data</TD></TR><TR><TD ALIGN='LEFT'>dashboard_layouts</TD></TR><TR><TD ALIGN='LEFT'>device_tokens</TD></TR><TR><TD ALIGN='LEFT'>dispatcher_decision_campaigns</TD></TR><TR><TD ALIGN='LEFT'>dispatcher_decision_items</TD></TR><TR><TD ALIGN='LEFT'>dispatcher_decisions</TD></TR><TR><TD ALIGN='LEFT'>dispatcher_events</TD></TR><TR><TD ALIGN='LEFT'>dispatcher_log</TD></TR><TR><TD ALIGN='LEFT'>emotion_data</TD></TR><TR><TD ALIGN='LEFT'>event_logs</TD></TR><TR><TD ALIGN='LEFT'>execution_logs</TD></TR><TR><TD ALIGN='LEFT'>export_executions</TD></TR><TR><TD ALIGN='LEFT'>export_queries</TD></TR><TR><TD ALIGN='LEFT'>export_schedules</TD></TR><TR><TD ALIGN='LEFT'>fx_sites</TD></TR><TR><TD ALIGN='LEFT'>fx_telemetry</TD></TR><TR><TD ALIGN='LEFT'>fx_totem_sites</TD></TR><TR><TD ALIGN='LEFT'>gesture_data</TD></TR><TR><TD ALIGN='LEFT'>interaction_logs</TD></TR><TR><TD ALIGN='LEFT'>ota_updates</TD></TR><TR><TD ALIGN='LEFT'>password_reset_tokens</TD></TR><TR><TD ALIGN='LEFT'>qr_codes</TD></TR><TR><TD ALIGN='LEFT'>recognized_persons</TD></TR><TR><TD ALIGN='LEFT'>remote_commands</TD></TR><TR><TD ALIGN='LEFT'>report_templates</TD></TR><TR><TD ALIGN='LEFT'>reports</TD></TR><TR><TD ALIGN='LEFT'>short_links</TD></TR><TR><TD ALIGN='LEFT'>smart_playlists</TD></TR><TR><TD ALIGN='LEFT'>stripe_customers</TD></TR><TR><TD ALIGN='LEFT'>tags</TD></TR><TR><TD ALIGN='LEFT'>totem_ml_config</TD></TR><TR><TD ALIGN='LEFT'>totem_update_status</TD></TR><TR><TD ALIGN='LEFT'>two_factor_attempts</TD></TR><TR><TD ALIGN='LEFT'>user_two_factor</TD></TR></TABLE>>];
  n_0 -> n_1 [weight=10];
  n_1 -> n_2 [weight=10];
  n_2 -> n_3 [weight=10];
  n_3 -> n_4 [weight=10];
  n_4 -> n_5 [weight=10];
  n_5 -> n_6 [weight=10];
  n_6 -> n_7 [weight=10];
  n_7 -> n_8 [weight=10];
}
