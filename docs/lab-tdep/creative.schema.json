{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://totemdigital.app.br/schemas/tdep/0.1/creative.json",
  "title": "TDEP 0.1 Creative",
  "description": "Pacote de mídia com variantes. Sem MP4 único. Sem audiência. Lab TotemDigital-Studio-A.i.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "creative_id",
    "owner_partner_id",
    "valid_from",
    "valid_until",
    "license",
    "brand_categories",
    "variants"
  ],
  "properties": {
    "schema": { "type": "string", "const": "tdep/0.1" },
    "creative_id": { "type": "string", "format": "uuid" },
    "owner_partner_id": { "type": "string", "format": "uuid" },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use", "territory"],
      "properties": {
        "use": { "type": "string", "enum": ["display"] },
        "territory": { "type": "string", "minLength": 2, "maxLength": 8 },
        "takedown_url": { "type": "string", "format": "uri" }
      }
    },
    "brand_categories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant_id",
          "orientation",
          "pixel_w",
          "pixel_h",
          "mime",
          "duration_ms",
          "audio",
          "uri",
          "sha256"
        ],
        "properties": {
          "variant_id": { "type": "string", "format": "uuid" },
          "orientation": { "type": "string", "enum": ["portrait", "landscape"] },
          "pixel_w": { "type": "integer", "minimum": 1, "maximum": 16384 },
          "pixel_h": { "type": "integer", "minimum": 1, "maximum": 16384 },
          "mime": { "type": "string", "minLength": 3 },
          "duration_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
          "audio": { "type": "boolean" },
          "uri": { "type": "string", "format": "uri" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  },
  "not": {
    "anyOf": [
      { "required": ["audience"] },
      { "required": ["person_id"] },
      { "required": ["ace"] },
      { "required": ["mood"] }
    ]
  }
}
