{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://totemdigital.app.br/schemas/tdep/0.1/partner.json",
  "title": "TDEP 0.1 Partner",
  "description": "Org que fala no TDEP. Sem audiência, sem factura. Lab TotemDigital-Studio-A.i.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "partner_id",
    "name",
    "roles",
    "handshake"
  ],
  "properties": {
    "schema": { "type": "string", "const": "tdep/0.1" },
    "partner_id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["seller", "buyer"] }
    },
    "handshake": { "type": "string", "enum": ["hmac", "mtls"] },
    "default_off": { "type": "boolean" }
  },
  "not": {
    "anyOf": [
      { "required": ["audience"] },
      { "required": ["person_id"] },
      { "required": ["ace"] },
      { "required": ["mood"] },
      { "required": ["invoice"] },
      { "required": ["cpm"] }
    ]
  }
}
