{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://totemdigital.app.br/schemas/tdep/0.1/availability.json",
  "title": "TDEP 0.1 Availability",
  "description": "Janelas cedíveis de uma face. Caps locais. Sem audiência. Lab TotemDigital-Studio-A.i.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "availability_id",
    "face_id",
    "seller_partner_id",
    "cedible",
    "windows",
    "cap_share_pct"
  ],
  "properties": {
    "schema": { "type": "string", "const": "tdep/0.1" },
    "availability_id": { "type": "string", "format": "uuid" },
    "face_id": { "type": "string", "format": "uuid" },
    "seller_partner_id": { "type": "string", "format": "uuid" },
    "cedible": { "type": "boolean" },
    "windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "until"],
        "properties": {
          "from": { "type": "string", "format": "date-time" },
          "until": { "type": "string", "format": "date-time" }
        }
      }
    },
    "cap_share_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
    "max_plays_per_day": { "type": "integer", "minimum": 1, "maximum": 100000 }
  },
  "not": {
    "anyOf": [
      { "required": ["audience"] },
      { "required": ["person_id"] },
      { "required": ["ace"] },
      { "required": ["mood"] }
    ]
  }
}
