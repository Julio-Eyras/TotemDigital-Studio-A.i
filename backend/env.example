# Smart Signage Pro v2.1 - Configuração de Ambiente
# ===================================================
# Copie este arquivo para .env e configure as variáveis
# IMPORTANTE: Em produção, altere JWT_SECRET e outras credenciais!

# =============================================
# SERVIDOR
# =============================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# =============================================
# BANCO DE DADOS (PostgreSQL)
# =============================================
DB_DRIVER=postgresql
DATABASE_URL=postgresql://smartsignage:smartsignage123@localhost:5432/smartsignage
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartsignage
DB_USER=smartsignage
DB_PASSWORD=smartsignage123
DB_POOL_SIZE=20
DB_CONNECTION_TIMEOUT=30000

# =============================================
# AUTENTICAÇÃO JWT
# =============================================
# ⚠️ ALTERE EM PRODUÇÃO! Use: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# SmartDisplayFX / MQTT (opcional - para orquestração de FX entre totens)
SMARTDISPLAYFX_MQTT_URL=mqtt://localhost:1883
SMARTDISPLAYFX_MQTT_USERNAME=
SMARTDISPLAYFX_MQTT_PASSWORD=
SMARTDISPLAYFX_MQTT_PREFIX=smartdisplay

# =============================================
# AUTENTICAÇÃO DE DOIS FATORES (2FA)
# =============================================
# Chave para criptografar secrets TOTP (usa JWT_SECRET como fallback)
# ⚠️ ALTERE EM PRODUÇÃO! Use: openssl rand -base64 32
TWO_FACTOR_ENCRYPTION_KEY=your-2fa-encryption-key-change-this-in-production

# =============================================
# SEGURANÇA
# =============================================
# PIN para abandonar player (4-6 dígitos)
PLAYER_ABANDON_PIN=1234
BCRYPT_ROUNDS=12

# =============================================
# PLAYER / TOTEM (API /api/player/* — sem página HTML)
# =============================================
# URL do servidor (usado para configurar players de campo)
# Se não definido, será construído automaticamente: http://HOST:PORT
SERVER_URL=http://localhost:3000

# Intervalo de heartbeat do player (ms)
HEARTBEAT_INTERVAL=30000

# Auto-iniciar player quando abrir
PLAYER_AUTO_START=true

# Modo fullscreen do player
PLAYER_FULLSCREEN=true

# Orientação portrait (vertical) do player
PLAYER_PORTRAIT=false

# CORS - Separe múltiplas origens por vírgula
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:8080

# TotemDigital compacto (monousuário)
# true = backend expõe apenas APIs essenciais e desativa superfícies Pro
TOTEMDIGITAL_COMPACT=true

# Modo Publicar em Totem (branch SmartSignage-direc-totem)
# Backend lê DIRECT_TOTEM_MODE em runtime; frontend lê REACT_APP_DIRECT_TOTEM_MODE em BUILD-TIME.
# Se alterar, é obrigatório rebuild do frontend (não basta restart).
# Ausente = true (modo direto ligado por padrão neste branch).
DIRECT_TOTEM_MODE=true
REACT_APP_DIRECT_TOTEM_MODE=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000          # 15 minutos
RATE_LIMIT_MAX_REQUESTS=100          # Máximo de requisições por janela
AUTH_RATE_LIMIT_WINDOW_MS=900000     # 15 minutos para autenticação
AUTH_RATE_LIMIT_MAX_REQUESTS=5       # 5 tentativas de login por 15 minutos
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000  # 1 hora para uploads
UPLOAD_RATE_LIMIT_MAX_REQUESTS=20    # 20 uploads por hora
SENSITIVE_RATE_LIMIT_WINDOW_MS=600000    # 10 minutos para operações sensíveis
SENSITIVE_RATE_LIMIT_MAX_REQUESTS=10     # 10 operações por 10 minutos

# Tamanho máximo de payload (formato: 10MB, 100KB, etc)
MAX_PAYLOAD_SIZE=10MB

# =============================================
# UPLOAD DE ARQUIVOS
# =============================================
UPLOAD_MAX_SIZE=100MB
UPLOAD_PATH=/opt/smart-signage/public/assets/uploads
MEDIA_QUOTA_PER_CLIENT=5GB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,video/ogg,video/quicktime,audio/mp3,audio/wav,audio/ogg

# =============================================
# REDIS / CACHE
# =============================================
CACHE_ENABLED=true
CACHE_TTL=3600                        # TTL padrão em segundos (1 hora)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================
# LOGGING
# =============================================
LOG_LEVEL=info                        # debug | info | warn | error
LOG_FILE=/opt/smart-signage/logs/app.log
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=5
LOG_ENABLE_CONSOLE=true

# =============================================
# IA / SMART PLAYLIST
# =============================================
# Provider: ollama | openai | anthropic
AI_PROVIDER=ollama
AI_MODEL=llama3.2:3b

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=30000

# OpenAI (opcional)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# Anthropic (opcional)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-haiku-20240307

# =============================================
# EMAIL (opcional)
# =============================================
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Smart Signage <noreply@smartsignage.com>
SMTP_TLS_REJECT_UNAUTHORIZED=true
FRONTEND_URL=http://localhost:3001

# =============================================
# MONITORAMENTO (opcional)
# =============================================
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true

# Prometheus
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_PORT=9090
PROMETHEUS_TIMEOUT=30000

# Grafana
GRAFANA_URL=http://localhost:3002
GRAFANA_API_KEY=
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=admin
GRAFANA_DATASOURCE_ID=1
GRAFANA_TIMEOUT=30000

# =============================================
# BACKUP
# =============================================
BACKUP_ENABLED=true
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/opt/smart-signage/backups

# =============================================
# ANALYTICS
# =============================================
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=365
ANALYTICS_BATCH_SIZE=1000

# =============================================
# STRIPE / PAGAMENTOS
# =============================================
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=brl
STRIPE_API_VERSION=2024-11-20.acacia

# =============================================
# FINANCEIRO / PIX (faturas de anunciantes)
# =============================================
FINANCIAL_PIX_KEY=
FINANCIAL_PIX_MERCHANT_NAME=SMART CHANNEL
FINANCIAL_PIX_MERCHANT_CITY=SAO PAULO
FINANCIAL_PIX_WEBHOOK_SECRET=
FINANCIAL_INVOICE_DUE_DAYS=7
FINANCIAL_DUE_SOON_DAYS=30
FINANCIAL_PUBLIC_APP_URL=
FINANCIAL_WHATSAPP_NUMBER=
FINANCIAL_CRON_ENFORCE_BLOCKS=15 4 * * *
# WhatsApp Cloud API (Meta) — envio automático; sem isto usa link wa.me no e-mail
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
FINANCIAL_WORKER_ENABLED=true
FINANCIAL_CRON_ISSUE=30 2 * * *
FINANCIAL_CRON_OVERDUE=30 3 * * *
FINANCIAL_CRON_REMINDERS=0 9 * * *

# =============================================
# DESENVOLVIMENTO
# =============================================
DEBUG=false
VERBOSE_LOGGING=false
