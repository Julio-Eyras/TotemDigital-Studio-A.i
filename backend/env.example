# Smart Signage v2.0 - Configuração Unificada
# =============================================

# Database Configuration
# ======================
# Banco de Dados (PostgreSQL apenas)
DB_DRIVER=postgresql

# PostgreSQL Configuration (Single-Server e Docker)
DATABASE_URL=postgresql://smartsignage:smartsignage123@localhost:5432/smartsignage

# Server Configuration
# ====================
PORT=3000
NODE_ENV=production
HOST=0.0.0.0

# JWT Configuration
# =================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Security Configuration
# ======================
# PIN para abandonar player (4-6 dígitos)
PLAYER_ABANDON_PIN=1234

# CORS Configuration
CORS_ORIGIN=http://localhost:8080,http://localhost:3001

# File Upload Configuration
# =========================
UPLOAD_MAX_SIZE=100MB
UPLOAD_PATH=/opt/smart-signage/public/assets/uploads
MEDIA_QUOTA_PER_CLIENT=5GB

# AI Configuration
# ================
# Provider: ollama | openai | anthropic
AI_PROVIDER=ollama
AI_MODEL=llama3.2:3b

# Ollama Configuration (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=30000

# OpenAI Configuration (opcional)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# Anthropic Configuration (opcional)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Smart Playlist Engine
# =====================
SMART_PLAYLIST_ENABLED=true
SMART_PLAYLIST_PYTHON_PATH=/usr/bin/python3
SMART_PLAYLIST_SCRIPT_PATH=/opt/smart-signage/modules/smart-playlist-engine

# System Configuration
# ====================
# UIN (Unique Identifier) - gerado automaticamente no first-boot
SYSTEM_UIN=SS-UNSET

# Display Configuration
DISPLAY_ROTATION=90
DISPLAY_WIDTH=1920
DISPLAY_HEIGHT=1080

# Logging Configuration
# =====================
LOG_LEVEL=info
LOG_FILE=/opt/smart-signage/logs/app.log
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=5

# Backup Configuration
# ====================
BACKUP_ENABLED=true
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/opt/smart-signage/backups

# Monitoring Configuration
# ========================
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# Email Configuration (opcional)
# ==============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Smart Signage <noreply@smartsignage.com>

# Webhook Configuration
# =====================
WEBHOOK_ENABLED=false
WEBHOOK_SECRET=your-webhook-secret

# Rate Limiting
# =============
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
# =====================
SESSION_SECRET=your-session-secret-change-this
SESSION_MAX_AGE=86400000

# Cache Configuration
# ===================
CACHE_ENABLED=true
CACHE_TTL=3600
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Grafana Configuration (CronSQL)
# ================================
GRAFANA_URL=http://localhost:3002
GRAFANA_API_KEY=
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=admin
GRAFANA_DATASOURCE_ID=1
GRAFANA_TIMEOUT=30000

# Prometheus Configuration (CronSQL)
# =================================
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT=30000

# Development Configuration
# =========================
DEBUG=true
VERBOSE_LOGGING=true
