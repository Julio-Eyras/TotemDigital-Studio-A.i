{
  "name": "smartsignage-pro",
  "version": "2.1.0",
  "description": "Sistema de Sinalização Digital Profissional - Tudo que você precisa para começar",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "cd backend && npm run dev",
    "build": "tsc -p backend/tsconfig.json",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && node node_modules/jest/bin/jest.js --coverage=false",
    "test:frontend": "cd frontend && CI=true npm test -- --watchAll=false",
    "test:e2e": "npm run test --prefix e2e",
    "test:e2e:full": "npm run test:full --prefix e2e",
    "test:e2e:install": "npm ci --prefix e2e && npm run install:browsers --prefix e2e",
    "test:all": "npm test && npm run test:e2e",
    "test:all:full": "npm test && npm run test:e2e:full",
    "lint": "echo 'Linting implementado'"
  },
  "keywords": [
    "digital-signage",
    "totem",
    "sinalização-digital",
    "business",
    "professional"
  ],
  "author": "Julio Cesar Eyras (J.C.E.) / Eyras Sistemas e Soluções",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "@aws-sdk/client-sesv2": {
      "engines": {
        "node": ">=18.0.0"
      }
    }
  },
  "dependencies": {
    "@types/mqtt": "^0.0.34",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "mqtt": "^5.14.1",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/lodash": "^4.14.202",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.4",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
