# TotemDigital Studio — instância @@TDI_ID@@ (@@TDI_LABEL@@)
# Gerado por Instala-TotemDigital-Server.sh — não editar placeholders manualmente.
# =============================================================================

NODE_ENV=production
PORT=@@TDI_BACKEND_PORT@@
HOST=0.0.0.0

# Domínio público desta instância (Let's Encrypt + Nginx)
DOMAIN_NAME=@@TDI_DOMAIN@@
PUBLIC_HOST=@@TDI_DOMAIN@@
SMARTSIGNAGE_DOMAIN_NAME=@@TDI_DOMAIN@@
SMARTSIGNAGE_PUBLIC_HOST=@@TDI_DOMAIN@@
SMARTSIGNAGE_SYSTEM_HTTP_PORT=@@TDI_HTTP_PORT@@
SMARTSIGNAGE_SPLIT_SITE=false

# TotemDigital compact + direct-totem
TOTEMDIGITAL_COMPACT=true
DIRECT_TOTEM_MODE=true
REACT_APP_DIRECT_TOTEM_MODE=true
REACT_APP_TOTEMDIGITAL_COMPACT=true

# Base de dados (isolada por instância)
DB_DRIVER=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=@@TDI_DB_NAME@@
DB_USER=@@TDI_DB_USER@@
DB_PASSWORD=@@TDI_DB_PASSWORD@@
DATABASE_URL=postgresql://@@TDI_DB_USER@@:@@TDI_DB_PASSWORD@@@localhost:5432/@@TDI_DB_NAME@@
DB_POOL_SIZE=20
DB_CONNECTION_TIMEOUT=30000

# Segredos (distintos por instância — NÃO reutilizar em prod)
JWT_SECRET=@@TDI_JWT_SECRET@@
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
TWO_FACTOR_ENCRYPTION_KEY=@@TDI_2FA_KEY@@
TOTEM_SECRET_KEY=@@TDI_TOTEM_SECRET@@

# Paths de deploy (isolados de /opt/smart-signage)
INSTALL_DIR=@@TDI_CLONE_DIR@@
FRONTEND_BUILD_PATH=@@TDI_OPT_ROOT@@/frontend/build
UPLOAD_PATH=@@TDI_OPT_ROOT@@/public/assets/uploads
LOG_FILE=@@TDI_OPT_ROOT@@/logs/app.log
PLAYER_DIR=@@TDI_OPT_ROOT@@/player-web
PLAYER_PATH=@@TDI_OPT_ROOT@@/player-web/index.html

# URLs públicas
SERVER_URL=https://@@TDI_DOMAIN@@
FINANCIAL_PUBLIC_APP_URL="https://@@TDI_DOMAIN@@"
CORS_ORIGIN=https://@@TDI_DOMAIN@@,http://127.0.0.1:@@TDI_BACKEND_PORT@@,http://127.0.0.1:@@TDI_HTTP_PORT@@

# Owner inicial (modo compact)
# Login principal da instância: @@TDI_LOGIN_USERNAME@@ / @@TDI_LOGIN_PASSWORD@@
# Publisher técnico: @@TDI_PUBLISHER_USERNAME@@ / @@TDI_PUBLISHER_PASSWORD@@
SYSTEM_OWNER_ADMIN_USERNAME=@@TDI_LOGIN_USERNAME@@
SYSTEM_OWNER_PUBLISHER_USERNAME=@@TDI_PUBLISHER_USERNAME@@
SYSTEM_OWNER_NAME=@@OWNER_NAME@@
SYSTEM_OWNER_EMAIL=@@SSL_EMAIL@@

# MQTT desligado por defeito em dev/test
SMARTDISPLAYFX_MQTT_URL=mqtt://127.0.0.1:1883
SMARTDISPLAYFX_MQTT_PREFIX=smartdisplay-@@TDI_ID@@

# Cache / Redis (partilhado no host — prefixo por instância se activar Redis depois)
CACHE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# Rate limits (iguais ao produto)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

UPLOAD_MAX_SIZE=100MB
MEDIA_QUOTA_PER_CLIENT=5GB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,video/ogg,video/quicktime,audio/mp3,audio/wav,audio/ogg

LOG_LEVEL=info
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=5
LOG_ENABLE_CONSOLE=true

PLAYER_ABANDON_PIN=1234
BCRYPT_ROUNDS=12
HEARTBEAT_INTERVAL=30000
PLAYER_AUTO_START=true
PLAYER_FULLSCREEN=true
PLAYER_PORTRAIT=false
PLAYER_PORT=0
