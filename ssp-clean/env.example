# Smart Signage Pro v2.0 - Configuração de Ambiente
# Copie este arquivo para .env e configure as variáveis

# =============================================
# SERVIDOR
# =============================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# =============================================
# PORTAS DOS SERVIÇOS (Docker)
# =============================================
# IMPORTANTE: As portas INTERNAS são onde os serviços escutam DENTRO do container
#            As portas EXTERNAS são onde o host expõe os serviços (mapeamento host:container)
#
# Exemplo: FRONTEND_INTERNAL_PORT=8080 (nginx escuta dentro do container)
#          FRONTEND_PORT=9090 (host expõe 9090, que mapeia para 8080 do container)
#          Acesso: http://host:9090 -> container:8080

# Portas INTERNAS (dentro dos containers - onde os serviços escutam)
FRONTEND_INTERNAL_PORT=8080    # Porta que o Nginx escuta dentro do container
BACKEND_INTERNAL_PORT=3000     # Porta que o Node.js escuta dentro do container
POSTGRES_INTERNAL_PORT=5432    # Porta que o PostgreSQL escuta dentro do container
REDIS_INTERNAL_PORT=6379       # Porta que o Redis escuta dentro do container
PROMETHEUS_INTERNAL_PORT=9090  # Porta que o Prometheus escuta dentro do container
GRAFANA_INTERNAL_PORT=3002     # Porta que o Grafana escuta dentro do container
OLLAMA_INTERNAL_PORT=11434      # Porta que o Ollama escuta dentro do container

# Portas EXTERNAS (no host - mapeamento host:container)
# Por padrão, todas as portas externas são iguais às internas (mesma porta no host e container)
FRONTEND_PORT=8080             # Host:8080 -> Container:8080 (mesma porta)
FRONTEND_ALT_PORT=3001        # Host:3001 -> Container:8080 (porta alternativa do frontend)
BACKEND_PORT=3000              # Host:3000 -> Container:3000 (mesma porta)
POSTGRES_PORT=5432             # Host:5432 -> Container:5432 (mesma porta)
REDIS_PORT=6379                # Host:6379 -> Container:6379 (mesma porta)
PROMETHEUS_PORT=9090           # Host:9090 -> Container:9090 (mesma porta)
GRAFANA_PORT=3002              # Host:3002 -> Container:3002 (mesma porta)
OLLAMA_PORT=11434              # Host:11434 -> Container:11434 (mesma porta)

# Exemplo de uso com portas diferentes:
# Se a porta 8080 já estiver ocupada no host, você pode fazer:
# FRONTEND_INTERNAL_PORT=8080  # Nginx continua escutando 8080 dentro do container
# FRONTEND_PORT=9090           # Host expõe 9090, que mapeia para 8080 do container
# Acesso: http://host:9090 -> container:8080

# =============================================
# FRONTEND (build / WebSocket)
# =============================================
# Opcional: URL do backend para o build do React (API + WebSocket).
# Se definido, o frontend usa esta URL para chamadas à API e para ws://.../ws.
# Se não definido, usa o mesmo host da página (recomendado quando Nginx faz proxy de /api e /ws).
# Ex.: REACT_APP_API_URL=http://192.168.1.110:3000 (útil se frontend e backend em portas diferentes)
# REACT_APP_API_URL=

# =============================================
# BANCO DE DADOS
# =============================================
# Banco de Dados (PostgreSQL apenas)
DATABASE_TYPE=postgresql
DATABASE_URL=postgresql://smartsignage:smartsignage123@localhost:5432/smartsignage

# =============================================
# AUTENTICAÇÃO
# =============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# =============================================
# ARMAZENAMENTO
# =============================================
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=100MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,video/ogg,audio/mp3,audio/wav,audio/ogg

# =============================================
# REDIS (OPCIONAL)
# =============================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================
# GRAFANA (OPCIONAL - Para CronSQL)
# =============================================
GRAFANA_URL=http://localhost:3002
GRAFANA_API_KEY=
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=admin
GRAFANA_DATASOURCE_ID=1
GRAFANA_TIMEOUT=30000

# =============================================
# PROMETHEUS (OPCIONAL - Para CronSQL)
# =============================================
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT=30000

# =============================================
# EMAIL
# =============================================
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Smart Signage <noreply@smartsignage.com>
SMTP_TLS_REJECT_UNAUTHORIZED=true
FRONTEND_URL=http://localhost:3001

# =============================================
# LOGS
# =============================================
LOG_LEVEL=info
LOG_FILE=./logs/smartsignage.log
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=5

# =============================================
# SEGURANÇA
# =============================================
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:3000,http://localhost:80

# =============================================
# PLAYER
# =============================================
PLAYER_API_URL=http://localhost:3000/api
PLAYER_HEARTBEAT_INTERVAL=30000
PLAYER_PLAYLIST_UPDATE_INTERVAL=300000
PLAYER_DEFAULT_DURATION=10000

# =============================================
# ANALYTICS
# =============================================
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=365
ANALYTICS_BATCH_SIZE=1000

# =============================================
# BACKUP
# =============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups

# =============================================
# MONITORAMENTO
# =============================================
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true
METRICS_PORT=9090

# =============================================
# SMARTDISPLAYFX / MQTT
# =============================================
# Configuração do broker MQTT para SmartDisplayFX
SMARTDISPLAYFX_MQTT_ENABLED=true
SMARTDISPLAYFX_MQTT_URL=mqtt://localhost:1883
SMARTDISPLAYFX_MQTT_WS_URL=ws://localhost:9001
SMARTDISPLAYFX_MQTT_USERNAME=
SMARTDISPLAYFX_MQTT_PASSWORD=
SMARTDISPLAYFX_MQTT_PREFIX=smartdisplay

# Portas MQTT (Docker)
MQTT_PORT=1883
MQTT_WS_PORT=9001

# =============================================
# DESENVOLVIMENTO
# =============================================
DEBUG=true
VERBOSE_LOGGING=true
HOT_RELOAD=true
