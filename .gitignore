# Smart Signage Pro specific
# Keep these files but ignore their contents
!database/schema.sql
!database/init-data.sql
!nginx/frontend.conf
!monitoring/prometheus/prometheus.yml
!monitoring/grafana/datasources/prometheus.yml

# Android SDK local (máquina específica)
SmartSignage-AD/local.properties
**/local.properties

# Gradle — cache e estado local (Android Studio / gradlew); nunca versionar
**/.gradle/

# Builds nativos Android (NDK / CMake)
**/.cxx/
**/.externalNativeBuild/

# APK/AAB em pacotes de pendrive (binários grandes; gerar com assemble/release)
install-pendrive/**/*.apk
install-pendrive-smartsignage-ad/**/*.apk

# Vídeos de demo do player-web (pesados; manter só imagens no Git — copiar .mp4 no deploy local)
player-web/propagandas/*.mp4
player-web/vinhetas/*.mp4
propagandas/*.mp4
vinhetas/*.mp4

# Artefactos acidentais na raiz (ficheiros vazios / lixo de npm)
/node
/smart-signage-frontend@2.1.0

# Pacotes / extrações locais na raiz (não versionar)
/TotemDigital-v1.zip
/TotemDigital-v1/
/SmartSignage-Pro-*.zip

# Extração local do pacote ER (manter só o .zip versionado em docs/)
/docs/ModeloERparaGerenciarMídiasEmTvsSmart/

