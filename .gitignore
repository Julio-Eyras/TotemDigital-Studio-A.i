package-lock.json
!backend/package-lock.json
yarn.lock

# Production builds
dist/
build/
*.tgz
*.tar.gz

# Frontend build (mas manter # public (comentado para incluir frontend/public/index.html)/index.html)
frontend/build/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
config.development.env

